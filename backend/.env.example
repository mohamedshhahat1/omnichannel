# ---------------------------------------------------------------------------
# Example configuration. Copy to `.env` for local development.
#
#   cp .env.example .env
#
# `.env` is git-ignored. NEVER put real secrets in this example file.
#
# Naming: every variable is prefixed `OC_`. Nested settings groups use a
# double underscore, e.g. `OC_SERVER__PORT` maps to `settings.server.port`.
# Complex values (lists/tuples) are parsed as JSON.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# development | test | production
OC_ENVIRONMENT=development
OC_DEBUG=true
OC_SERVICE_NAME=omnichannel-api
OC_API_PREFIX=/api

# --- Server -----------------------------------------------------------------
OC_SERVER__HOST=127.0.0.1
OC_SERVER__PORT=8000
# Only enable once a trusted reverse proxy (NGINX, Phase 2) is the sole ingress
# and is guaranteed to overwrite this header on every inbound request.
OC_SERVER__TRUST_INBOUND_REQUEST_ID=false
OC_SERVER__MAX_REQUEST_BODY_BYTES=10485760

# How many reverse proxies sit between the client and this process.
#
# 0 means the peer address is the client address and no forwarding header is
# read at all. That is the safe default, but it is NOT the correct value behind
# a proxy: with NGINX in front, every request appears to come from NGINX, so
# the per-source login limiter puts the entire internet in one bucket and the
# audit log records the proxy's address instead of the caller's. Set this to
# the number of proxies you actually control - 1 for the Phase 2 NGINX
# topology. Setting it too high is worse than too low: a caller could then
# forge `X-Forwarded-For` and choose their own rate-limit bucket.
OC_SERVER__TRUSTED_PROXY_HOPS=0
OC_SERVER__FORWARDED_FOR_HEADER=X-Forwarded-For

# --- Logging ----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
OC_LOGGING__LEVEL=DEBUG
# json (required in production) | console (readable locally)
OC_LOGGING__FORMAT=console

# --- Observability ----------------------------------------------------------
# Tracing is OFF by default so local development needs no tracing backend.
OC_OBSERVABILITY__TRACING_ENABLED=false
# none | console | otlp
OC_OBSERVABILITY__EXPORTER=none
# Required when exporter=otlp, e.g. http://localhost:4318/v1/traces
# OC_OBSERVABILITY__OTLP_ENDPOINT=
OC_OBSERVABILITY__SAMPLE_RATIO=1.0

# --- Security ---------------------------------------------------------------
# JSON array. Must be explicit (no "*") in production.
OC_SECURITY__CORS_ORIGINS=["http://localhost:3000"]
OC_SECURITY__CORS_ALLOW_CREDENTIALS=true
# JSON array. Must be non-empty and must not contain "*" in production.
OC_SECURITY__TRUSTED_HOSTS=[]

# Browser origin validation for cookie-authenticated writes
# (docs/security.md 2.4, layer 3). Origins allowed to CHANGE STATE, in addition
# to CORS_ORIGINS and the application's own host - which always passes, so a
# single-origin deployment needs nothing here. Kept separate from CORS because
# CORS answers "may this origin read the response?" and this answers "may this
# origin change state?"; the second list is the one that has to stay short.
# JSON array. Must not contain "*" in production.
OC_SECURITY__CSRF_TRUSTED_ORIGINS=[]

# Whether an unsafe cookie-authenticated request must carry an `Origin` or
# `Referer` header at all. PRODUCTION REQUIRES IT UNCONDITIONALLY and ignores
# this value - there is no key that switches the control off where it protects
# anyone. The flag exists so curl, the test suite and local tooling can drive
# the API without pretending to be a browser.
OC_SECURITY__REQUIRE_ORIGIN_ON_COOKIE_WRITES=false

# --- Database (Phase 2) -----------------------------------------------------
# Local-only example credentials. Provision real secrets outside source control.
OC_DATABASE__URL=postgresql+asyncpg://oc_app:oc_app_password@postgres:5432/omnichannel
OC_DATABASE__MIGRATION_URL=postgresql+asyncpg://oc_migrator:oc_migrator_password@postgres:5432/omnichannel
OC_DATABASE__POOL_SIZE=5
OC_DATABASE__MAX_OVERFLOW=5
OC_DATABASE__POOL_TIMEOUT_SECONDS=5
OC_DATABASE__POOL_RECYCLE_SECONDS=1800
OC_DATABASE__STATEMENT_TIMEOUT_MS=10000
OC_DATABASE__LOCK_TIMEOUT_MS=2000
OC_DATABASE__HEALTH_TIMEOUT_SECONDS=2

# --- Redis (Phase 2) --------------------------------------------------------
OC_REDIS__URL=redis://redis:6379/0
OC_REDIS__MAX_CONNECTIONS=20
OC_REDIS__SOCKET_CONNECT_TIMEOUT_SECONDS=2
OC_REDIS__SOCKET_TIMEOUT_SECONDS=2
OC_REDIS__HEALTH_TIMEOUT_SECONDS=2

# --- Celery (Phase 2) -------------------------------------------------------
OC_CELERY__BROKER_URL=redis://redis:6379/1
OC_CELERY__RESULT_BACKEND_ENABLED=false
# Optional only if RESULT_BACKEND_ENABLED=true
# OC_CELERY__RESULT_BACKEND_URL=redis://redis:6379/2
OC_CELERY__DEFAULT_QUEUE=default
OC_CELERY__CRITICAL_QUEUE=critical
OC_CELERY__BACKGROUND_QUEUE=background
OC_CELERY__TASK_SOFT_TIME_LIMIT_SECONDS=270
OC_CELERY__TASK_TIME_LIMIT_SECONDS=300
OC_CELERY__WORKER_PREFETCH_MULTIPLIER=1

# --- Auth / identity (Phase 3) ----------------------------------------------
# Argon2id cost. The production floor (65536 KiB, time cost 3) is enforced by
# a settings validator; these are the same values, shown so they are visible
# and tunable rather than buried. Lower them locally only if login latency in
# development is genuinely painful, and never in a deployed environment.
OC_AUTH__ARGON2_TIME_COST=3
OC_AUTH__ARGON2_MEMORY_KIB=65536
OC_AUTH__ARGON2_PARALLELISM=4
OC_AUTH__ARGON2_HASH_BYTES=32
OC_AUTH__ARGON2_SALT_BYTES=16

# Password policy. The minimum is length-based on purpose: length beats
# composition rules, which mostly produce "Password1!" and a sticky note.
OC_AUTH__PASSWORD_MIN_LENGTH=12
OC_AUTH__PASSWORD_MAX_LENGTH=1024

# Screen new passwords against a local breached-password list
# (docs/security.md 2.5). The list ships in the application, so the check makes
# no network call and cannot leak a password or fail because a third party is
# down. There is no operational reason to turn it off and PRODUCTION REFUSES TO
# START with it disabled; the switch exists for the same reason the Argon2 cost
# is a setting.
OC_AUTH__BREACH_SCREEN_ENABLED=true

# Sessions. Idle expiry logs out abandoned sessions; absolute expiry caps the
# lifetime of a stolen cookie no matter how actively it is used.
OC_AUTH__SESSION_IDLE_TTL_SECONDS=604800
OC_AUTH__SESSION_ABSOLUTE_TTL_SECONDS=2592000
# How stale `last_seen_at` may get before a request writes it back. Without
# this, every authenticated GET would issue a write.
OC_AUTH__SESSION_TOUCH_INTERVAL_SECONDS=60
# TTL of the Redis effective-permission cache. It holds the permission set
# already resolved from `role_permissions`, not role slugs, so nothing
# re-derives a decision from a cached value. Short, because it bounds how long
# a permission change could survive a cache entry that escaped explicit
# invalidation.
OC_AUTH__SESSION_CACHE_TTL_SECONDS=60

# Cookies. The production defaults are `__Host-` prefixed and Secure, which a
# settings validator enforces. The `__Host-` prefix REQUIRES HTTPS, so plain
# http://localhost development must use the unprefixed names below.
OC_AUTH__SESSION_COOKIE_NAME=oc_session
OC_AUTH__CSRF_COOKIE_NAME=oc_csrf
OC_AUTH__CSRF_HEADER_NAME=X-CSRF-Token
OC_AUTH__COOKIE_SECURE=false
# lax | strict | none
OC_AUTH__COOKIE_SAMESITE=lax
OC_AUTH__COOKIE_PATH=/

# Single-use email token lifetimes.
OC_AUTH__EMAIL_VERIFICATION_TTL_SECONDS=86400
OC_AUTH__CREDENTIAL_RESET_TTL_SECONDS=1800

# API keys always expire; this is the ceiling a caller may request.
OC_AUTH__API_KEY_MAX_TTL_DAYS=365

# Failed-login throttling, per ACCOUNT. The counter lives on the user row, so
# it survives a restart and a Redis outage. It protects the account under
# attack, which also means it is stepped around by spreading one attempt across
# many accounts - see the per-source limiter below.
OC_AUTH__MAX_FAILED_LOGINS=10
OC_AUTH__LOCKOUT_SECONDS=900

# Failed-login throttling, per SOURCE ADDRESS (docs/security.md 2.5). The other
# half of the control: it counts every attempt from one address whatever account
# it names and whether or not it succeeds, so rotating victims does not reset
# it. Requires OC_SERVER__TRUSTED_PROXY_HOPS to be correct - otherwise every
# request buckets to the proxy. Production refuses to start with it disabled.
# The numbers are deliberately generous compared with human behaviour: 20
# attempts in five minutes is far more than someone mistyping a password and
# far less than automation needs to be worth running. Raise them where many
# real users share one egress address.
OC_AUTH__LOGIN_RATE_LIMIT_ENABLED=true
OC_AUTH__LOGIN_RATE_LIMIT_MAX_ATTEMPTS=20
OC_AUTH__LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# What to do when Redis cannot answer. Open by default: the per-account lockout
# is unaffected by a Redis outage, so failing open degrades to exactly the
# protection that existed before this limiter, while failing closed turns a
# cache outage into a total authentication outage. Set false where an
# authentication outage is preferable to an unthrottled window.
OC_AUTH__LOGIN_RATE_LIMIT_FAIL_OPEN=true

# Opt-in integration tests. These MUST use real PostgreSQL and Redis, never
# SQLite, and are intentionally unset by default.
# OC_TEST_DATABASE_URL=postgresql+asyncpg://oc_app:oc_app_password@localhost:5432/omnichannel_test
# OC_TEST_REDIS_URL=redis://localhost:6379/15

# ---------------------------------------------------------------------------
# NOT YET USED - added by the phase that implements them.
#
#   Phase 6  OC_META__*
#   Phase 8  OC_LLM__*
#   Phase 9  OC_STORAGE__*  (S3-compatible)
#   Phase 12 OC_PADDLE__*
#   Phase 13 OC_SENTRY__DSN
#
# Do not add these here until the corresponding settings group exists.
# ---------------------------------------------------------------------------

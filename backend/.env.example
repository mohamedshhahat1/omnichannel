# ---------------------------------------------------------------------------
# Example configuration. Copy to `.env` for local development.
#
#   cp .env.example .env
#
# `.env` is git-ignored. NEVER put real secrets in this example file.
#
# Naming: every variable is prefixed `OC_`. Nested settings groups use a
# double underscore, e.g. `OC_SERVER__PORT` maps to `settings.server.port`.
# Complex values (lists/tuples) are parsed as JSON.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# development | test | production
OC_ENVIRONMENT=development
OC_DEBUG=true
OC_SERVICE_NAME=omnichannel-api
OC_API_PREFIX=/api

# --- Server -----------------------------------------------------------------
OC_SERVER__HOST=127.0.0.1
OC_SERVER__PORT=8000
# Only enable once a trusted reverse proxy (NGINX, Phase 2) is the sole ingress
# and is guaranteed to overwrite this header on every inbound request.
OC_SERVER__TRUST_INBOUND_REQUEST_ID=false
OC_SERVER__MAX_REQUEST_BODY_BYTES=10485760

# --- Logging ----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
OC_LOGGING__LEVEL=DEBUG
# json (required in production) | console (readable locally)
OC_LOGGING__FORMAT=console

# --- Observability ----------------------------------------------------------
# Tracing is OFF by default so local development needs no tracing backend.
OC_OBSERVABILITY__TRACING_ENABLED=false
# none | console | otlp
OC_OBSERVABILITY__EXPORTER=none
# Required when exporter=otlp, e.g. http://localhost:4318/v1/traces
# OC_OBSERVABILITY__OTLP_ENDPOINT=
OC_OBSERVABILITY__SAMPLE_RATIO=1.0

# --- Security ---------------------------------------------------------------
# JSON array. Must be explicit (no "*") in production.
OC_SECURITY__CORS_ORIGINS=["http://localhost:3000"]
OC_SECURITY__CORS_ALLOW_CREDENTIALS=true
# JSON array. Must be non-empty and must not contain "*" in production.
OC_SECURITY__TRUSTED_HOSTS=[]

# --- Database (Phase 2) -----------------------------------------------------
# Local-only example credentials. Provision real secrets outside source control.
OC_DATABASE__URL=postgresql+asyncpg://oc_app:oc_app_password@postgres:5432/omnichannel
OC_DATABASE__MIGRATION_URL=postgresql+asyncpg://oc_migrator:oc_migrator_password@postgres:5432/omnichannel
OC_DATABASE__POOL_SIZE=5
OC_DATABASE__MAX_OVERFLOW=5
OC_DATABASE__POOL_TIMEOUT_SECONDS=5
OC_DATABASE__POOL_RECYCLE_SECONDS=1800
OC_DATABASE__STATEMENT_TIMEOUT_MS=10000
OC_DATABASE__LOCK_TIMEOUT_MS=2000
OC_DATABASE__HEALTH_TIMEOUT_SECONDS=2

# --- Redis (Phase 2) --------------------------------------------------------
OC_REDIS__URL=redis://redis:6379/0
OC_REDIS__MAX_CONNECTIONS=20
OC_REDIS__SOCKET_CONNECT_TIMEOUT_SECONDS=2
OC_REDIS__SOCKET_TIMEOUT_SECONDS=2
OC_REDIS__HEALTH_TIMEOUT_SECONDS=2

# --- Celery (Phase 2) -------------------------------------------------------
OC_CELERY__BROKER_URL=redis://redis:6379/1
OC_CELERY__RESULT_BACKEND_ENABLED=false
# Optional only if RESULT_BACKEND_ENABLED=true
# OC_CELERY__RESULT_BACKEND_URL=redis://redis:6379/2
OC_CELERY__DEFAULT_QUEUE=default
OC_CELERY__CRITICAL_QUEUE=critical
OC_CELERY__BACKGROUND_QUEUE=background
OC_CELERY__TASK_SOFT_TIME_LIMIT_SECONDS=270
OC_CELERY__TASK_TIME_LIMIT_SECONDS=300
OC_CELERY__WORKER_PREFETCH_MULTIPLIER=1

# Opt-in integration tests. These MUST use real PostgreSQL and Redis, never
# SQLite, and are intentionally unset by default.
# OC_TEST_DATABASE_URL=postgresql+asyncpg://oc_app:oc_app_password@localhost:5432/omnichannel_test
# OC_TEST_REDIS_URL=redis://localhost:6379/15

# ---------------------------------------------------------------------------
# NOT YET USED - added by the phase that implements them.
#
#   Phase 6  OC_META__*
#   Phase 8  OC_LLM__*
#   Phase 9  OC_STORAGE__*  (S3-compatible)
#   Phase 12 OC_PADDLE__*
#   Phase 13 OC_SENTRY__DSN
#
# Do not add these here until the corresponding settings group exists.
# ---------------------------------------------------------------------------
